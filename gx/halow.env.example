# HaLow settings for this GX. install.sh copies this to /data/halow/halow.env once and never overwrites it.
# Read by load.sh and both services.

# Regulatory domain (ISO alpha-2). Required. The driver's built-in default is AU. US allows 902 to 928 MHz.
HALOW_COUNTRY=US

# Extra driver options. enable_ps=0 turns the driver's power save off (its default is 2, fully enabled).
# Its effect on its own is not measured yet. See the README.
MORSE_OPTS="enable_ps=0"

# This GX's addresses: one on the mesh, one on loopback that Babel announces. Pick ones that are unique on your mesh.
HALOW_ADDR=10.100.250.1/16
BABEL_ADDR=10.200.250.1/32
# The prefix that holds every member's loopback. Babel announces and accepts only addresses inside it (plus a
# default route). NAT_NETS are the mesh source ranges this GX NATs when it acts as an exit.
LOOPBACK_PREFIX=10.200.0.0/16
NAT_NETS="10.100.0.0/16 10.200.0.0/16"

# Internet exit. 1 = offer this GX's best working uplink to the mesh, at a Babel cost per uplink type (lower
# wins). One good radio hop costs about 256. halow-exit probes every uplink and offers one only while it passes.
# Routes learned from Babel go into the kernel at metric 900, so a working uplink of this GX's own beats the mesh.
HALOW_EXIT=1
EXIT_METRIC_ETH=256      # eth0: wired or Starlink
EXIT_METRIC_WIFI=512     # wifi0: a Wi-Fi client uplink
EXIT_METRIC_MODEM=4096   # ppp0: GX LTE modem, last resort

# Addresses halow-exit probes to test an uplink. This GX never forwards mesh traffic to them, so pick addresses
# nothing on the mesh needs. EXIT_HOLD_SECONDS is the wait before an uplink that was down is used again.
PROBE_TARGETS="1.0.0.1 8.8.4.4"
EXIT_HOLD_SECONDS=20

# DNS servers to use when this GX's only internet route is the mesh and Venus OS has no resolver servers left
# (no Ethernet, Wi-Fi or modem). Reached through the mesh exit's NAT. Empty turns the fallback off.
FALLBACK_DNS="1.1.1.1 8.8.8.8"
