#!/bin/sh
# Babel routing over halow0 only, supervised by daemontools.
# This GX announces its loopback address and, when HALOW_EXIT=1, the uplink that halow-exit found healthy, at a
# cost per uplink type. Routes it learns go into the kernel at metric 900, so its own Ethernet, Wi-Fi or modem default wins.
exec 2>&1
H=/data/halow
[ -r $H/halow.env ] && . $H/halow.env
if [ ! -e /sys/class/net/halow0 ]; then
  echo "halow: waiting for the HaLow radio"
  until [ -e /sys/class/net/halow0 ]; do sleep 5; done
  echo "halow: radio found"
fi
ip addr replace ${BABEL_ADDR:?set BABEL_ADDR in halow.env} dev lo
set -- -I /run/halow-babel.pid -S $H/babel.state -g 33123 -k 900
if [ "${HALOW_EXIT:-0}" = 1 ]; then
  # Exits come from table 210 only. halow-exit puts this GX's best uplink there while it passes the probe, with a
  # route protocol number per uplink type, and babeld prices each protocol. Nothing is read from the main table,
  # so an untested default route is never offered. (babeld also skips "proto boot" routes, which is what connman
  # installs, so the main table's default would not be announced anyway.)
  set -- "$@" -C "import-table 210" \
              -C "redistribute proto 200 ip 0.0.0.0/0 eq 0 metric ${EXIT_METRIC_ETH:-256}" \
              -C "redistribute proto 203 ip 0.0.0.0/0 eq 0 metric ${EXIT_METRIC_WIFI:-512}" \
              -C "redistribute proto 202 ip 0.0.0.0/0 eq 0 metric ${EXIT_METRIC_MODEM:-4096}"
  # NAT mesh traffic out of any non-mesh interface (idempotent).
  for net in ${NAT_NETS:-10.100.0.0/16 10.200.0.0/16}; do
    iptables -t nat -C POSTROUTING -s $net ! -o halow0 -j MASQUERADE 2>/dev/null \
      || iptables -t nat -A POSTROUTING -s $net ! -o halow0 -j MASQUERADE
  done
  echo 1 > /proc/sys/net/ipv4/ip_forward
fi
set -- "$@" -C "redistribute local ip ${LOOPBACK_PREFIX:-10.200.0.0/16} le 32 allow" -C "redistribute local deny" -C "redistribute deny"
# Accept only what the mesh is meant to carry: member loopbacks and a default route. Without this, a peer could
# announce a more specific prefix (a LAN range, a cloud server /32) and pull that traffic onto the mesh, because a
# specific route wins over this GX's own default whatever the kernel metric.
set -- "$@" -C "in ip ${LOOPBACK_PREFIX:-10.200.0.0/16} le 32 allow" -C "in ip 0.0.0.0/0 eq 0 allow" -C "in deny" halow0
rm -f /run/halow-babel.pid
export LD_LIBRARY_PATH=$H/lib
exec $H/bin/babeld "$@"
